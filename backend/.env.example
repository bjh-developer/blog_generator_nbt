# Copy to .env and fill. Cloudflare creds + Firecrawl required for live runs.
# OPENROUTER_API_KEY is only used for the fallback model (owl-alpha).
OPENROUTER_API_KEY=
# Primary discovery + scrape source (Firecrawl v2 /search)
FIRECRAWL_API_KEY=

# Model routing (free OpenRouter models)
MODEL_FAST=nvidia/nemotron-3-nano-30b-a3b:free
MODEL_GENERAL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_EDITORIAL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b:free
MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
# judge: reasoning-tier critic for post-generation quality/safety/fact review
MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b:free

# Throttle / quota — tune for Cloudflare per-model limits (was OpenRouter 18 rpm)
LLM_RPM=18
PROMPT_CACHE=0

# Verification
VERIFY_THRESHOLD=0.6
USE_EMBEDDINGS=0

# Dev fixture — skip live Firecrawl calls (set to fixture path, leave blank for live)
# USE_FIXTURE=data/fixtures/firecrawl_airbnb.json

# Where generated JSON lands (SYNC/CLI mode only). Point at the NextBigThing repo
# to preview locally; unset to use web/content/breakdowns. In webhook/async mode
# (admin dashboard) the brief is returned in the callback and NOT written to disk.
# CONTENT_DIR=/path/to/NextBigThing/content/blog

# Shared bearer token with the NextBigThing admin. MUST match GENERATOR_SHARED_SECRET
# set in Vercel. Guards POST /generate and is sent on the completion callback.
# Generate a strong random value, e.g.:  openssl rand -hex 32
GENERATOR_SHARED_SECRET=

# SSRF guard: hostnames the generator may POST results (+ the secret) back to.
# REQUIRED whenever GENERATOR_SHARED_SECRET is set. Comma-separated, no scheme.
# Prod example: nextbigthingsg.com   Local dev: localhost
GENERATOR_CALLBACK_ALLOWLIST=
